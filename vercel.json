{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "backend": {
            "root": "backend",
            "runtime": "python",
            "entrypoint": "app.py"
        },
        "frontend": {
            "root": "frontend",
            "framework": "create-react-app"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}